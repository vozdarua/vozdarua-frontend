# API backend (Java Quarkus)
# Dev local: relativo, repassado pelo proxy do Vite (vite.config.js) para
# http://localhost:8080. Em produção (Railway), defina VITE_API_URL nas
# variáveis do serviço com a URL pública do backend — não commite aqui.
VITE_API_URL=/api

# Nome da aplicação
VITE_APP_NAME=fiscalizaí

# API externa (sem chave — gratuita) — usada apenas para GPS → endereço.
# Consulta de CEP é feita pelo próprio backend (GET /location/cep/{cep}).
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
